package com.baining.str.ui.theme

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.platform.LocalContext

//── 深色方案 ───────────────────────────────────────────────
private val DarkColorScheme = darkColorScheme(
    primary             = IosBlue,
    onPrimary= Color.White,
    primaryContainer    = IosBlueDark,
    onPrimaryContainer= Color.White,
    secondary           = IosTeal,
    onSecondary         = Color.White,
    tertiary            = IosPurple,
    background          = BgDark1,
    onBackground        = Color.White,
    surface             = CardDark,
    onSurface           = Color.White,
    surfaceVariant      = Color(0xFF2C2C2E),
    onSurfaceVariant    = IosGray2,
    outline             = IosGray1,
    error               = IosRed,
    onError             = Color.White,
)

// ── 浅色方案 ───────────────────────────────────────────────
private val LightColorScheme = lightColorScheme(
    primary             = IosBlue,
    onPrimary           = Color.White,
    primaryContainer    = IosBlueLight,
    onPrimaryContainer  = Color.White,
    secondary           = Color(0xFF0080CC),
    onSecondary         = Color.White,
    tertiary            = IosPurple,
    background          = BgLight1,
    onBackground        = Color(0xFF1C1C1E),
    surface             = CardLight,
    onSurface           = Color(0xFF1C1C1E),
    surfaceVariant      = IosGray6,
    onSurfaceVariant    = Color(0xFF3A3A3C),
    outline             = IosGray3,
    error               = IosRed,
    onError             = Color.White,
)

val LocalIsDarkTheme = staticCompositionLocalOf { true }

@Composable
fun AppTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit
) {
    val colorScheme = if (darkTheme) DarkColorScheme else LightColorScheme
    val context = LocalContext.current

    // 从 FontProvider 获取合并字体：
    // API 29+：CustomFallbackBuilder 实现字符级fallback（Latin→FontEn，CJK→FontCn）
    // API 26-28：FontCn 主字体，Latin 由系统 fallback 兜底
    val mergedFont = remember(context) { FontProvider.getMergedFont(context) }
    val typography = remember(mergedFont) { buildTypography(mergedFont) }

    MaterialTheme(
        colorScheme = colorScheme,
        typography = typography,
        content = content
    )
}
